# ---------------------------------------------------------------------------
# Copia este archivo a `.env` (que está en .gitignore) y ajusta los valores.
# `docker compose` lee automáticamente este archivo para sustituir las variables.
# ---------------------------------------------------------------------------

# --- SQL Server 2022 (Docker) ---------------------------------------------
# Contraseña del usuario sa. Cumple los requisitos de complejidad de SQL Server.
MSSQL_SA_PASSWORD=CAMBIAR_ESTA_CONTRASENA_POR_UNA_DE_AL_MENOS_8_CARACTERES
MSSQL_USER=sa
MSSQL_PASSWORD=CAMBIAR_ESTA_CONTRASENA_POR_UNA_DE_AL_MENOS_8_CARACTERES
MSSQL_DB=Pedidos
MSSQL_PORT=1433

# --- API .NET (cadenas de conexión) ---------------------------------------
# Debe usar la MISMA contraseña que MSSQL_SA_PASSWORD.
ConnectionStrings__Pedidos=Server=localhost,1433;Database=Pedidos;User Id=sa;Password=CAMBIAR_ESTA_CONTRASENA_POR_UNA_DE_AL_MENOS_8_CARACTERES;TrustServerCertificate=True;Encrypt=False
# Base de datos aislada que usan los tests de integración.
ConnectionStrings__PedidosTests=Server=localhost,1433;Database=Pedidos_Tests;User Id=sa;Password=CAMBIAR_ESTA_CONTRASENA_POR_UNA_DE_AL_MENOS_8_CARACTERES;TrustServerCertificate=True;Encrypt=False

# --- JWT -------------------------------------------------------------------
# Clave de firma HS256: mínimo 32 caracteres. Genera una con:
#   dotnet user-secrets set "Jwt:Key" "$(openssl rand -base64 48)"
Jwt__Key=CAMBIAR_ESTA_CLAVE_POR_UNA_DE_AL_MENOS_32_CARACTERES_ALEATORIA
# Minutos de vida del token.
Jwt__ExpiracionMinutos=60
