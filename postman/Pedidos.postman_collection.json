{
  "info": {
    "name": "Pedidos API",
    "description": "Colección del reto técnico: autenticación JWT y CRUD de pedidos.\n\n1. Ejecuta primero «Autenticación / Login» (guarda el token en la variable `token`).\n2. El resto de peticiones usa `{{token}}` en la cabecera Authorization.\n\nCredenciales: user@email.com / 123456 (User) · admin@email.com / Admin123! (Admin)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "pedidoId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login devuelve 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const respuesta = pm.response.json();",
                  "pm.test('Devuelve token y expiracion', function () {",
                  "    pm.expect(respuesta.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(respuesta.expiresIn).to.be.above(0);",
                  "});",
                  "",
                  "pm.collectionVariables.set('token', respuesta.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@email.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Inicia sesión y guarda el token en la variable de colección `token`."
          }
        },
        {
          "name": "Login con credenciales incorrectas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@email.com\",\n  \"password\": \"incorrecta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Devuelve 401 con un mensaje genérico (no revela si el email existe)."
          }
        },
        {
          "name": "Login con body inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-es-un-email\",\n  \"password\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Devuelve 400 con los errores por campo."
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Listar pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos"]
            }
          }
        },
        {
          "name": "Listar pedidos paginado y filtrado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/paginado?pagina=1&pageSize=20&estado=Registrado&cliente=Juan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "paginado"],
              "query": [
                { "key": "pagina", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "estado", "value": "Registrado" },
                { "key": "cliente", "value": "Juan" }
              ]
            }
          }
        },
        {
          "name": "Obtener pedido por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "{{pedidoId}}"]
            }
          }
        },
        {
          "name": "Crear pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crear devuelve 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('pedidoId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroPedido\": \"PED-001\",\n  \"cliente\": \"Juan Perez\",\n  \"fecha\": \"2025-01-10T00:00:00\",\n  \"total\": 250.75,\n  \"estado\": \"Registrado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos"]
            },
            "description": "Devuelve 201 con la cabecera Location y el pedido creado."
          }
        },
        {
          "name": "Crear pedido duplicado (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroPedido\": \"PED-001\",\n  \"cliente\": \"Otro Cliente\",\n  \"fecha\": \"2025-01-10T00:00:00\",\n  \"total\": 100.00,\n  \"estado\": \"Registrado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos"]
            },
            "description": "Devuelve 409: el número de pedido ya existe (único también entre eliminados)."
          }
        },
        {
          "name": "Crear pedido con total inválido (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroPedido\": \"PED-002\",\n  \"cliente\": \"Ana Lopez\",\n  \"fecha\": \"2025-01-10T00:00:00\",\n  \"total\": 0,\n  \"estado\": \"Registrado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos"]
            },
            "description": "Devuelve 400 con el error en el campo `total`."
          }
        },
        {
          "name": "Actualizar pedido",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroPedido\": \"PED-001\",\n  \"cliente\": \"Empresa Norte\",\n  \"fecha\": \"2025-03-01T00:00:00\",\n  \"total\": 150.50,\n  \"estado\": \"EnProceso\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "{{pedidoId}}"]
            },
            "description": "El identificador de la ruta manda sobre el del cuerpo."
          }
        },
        {
          "name": "Eliminar pedido (solo Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "{{pedidoId}}"]
            },
            "description": "Devuelve 204 con rol Admin y 403 con rol User. La eliminación es lógica."
          }
        },
        {
          "name": "Pedido inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "999999"]
            }
          }
        },
        {
          "name": "Sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos"]
            }
          }
        }
      ]
    },
    {
      "name": "Sistema",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Comprueba la API y la conexión con SQL Server."
          }
        },
        {
          "name": "OpenAPI (Swagger)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/swagger/v1/swagger.json",
              "host": ["{{baseUrl}}"],
              "path": ["swagger", "v1", "swagger.json"]
            }
          }
        }
      ]
    }
  ]
}
